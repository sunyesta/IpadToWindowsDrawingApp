<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DrawingServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thin COM wrappers for D3D11 / DXGI (Desktop Duplication API). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
    <PackageReference Include="Vortice.DXGI" Version="3.*" />
  </ItemGroup>

</Project>
